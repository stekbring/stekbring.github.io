{
  "id": "./",
  "name": "Angelradio",
  "short_name": "Angelradio",
  "description": "Inställningar, sändare, egna larmljud och uppdatering för Angelradio-mottagaren.",
  "lang": "sv",
  "start_url": "./?app",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101216",
  "theme_color": "#14171b",
  "launch_handler": { "client_mode": "focus-existing" },
  "categories": ["utilities", "sports"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Räckviddstest", "url": "./#rackvidd", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Uppdatera programvaran", "url": "./#uppdatera", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
